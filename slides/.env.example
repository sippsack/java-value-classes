# Optional: add a JDK home for local discovery.
# Copy to .env.local, set the absolute JDK home (not its bin directory),
# and restart the Slidev server. The highest detected version is selected.
# JAVA_SANDBOX_HOME=/absolute/path/to/jdk

# External execution, public URL including /run. No tokens/secrets in this URL.
# This value is embedded into the static client at build time.
# VITE_JAVA_SANDBOX_PROXY_URL=https://your-proxy.example/run

# Auto-generated on dev-server startup in .env.local; extra JDK homes can be
# added here for discovery outside SDKMAN/OS standard locations. Highest wins.
# JAVA_SANDBOX_JDKS='["/absolute/path/to/jdk"]'

# Public provider list. Optional proxyUrl per entry overrides the shared proxy.
# Do not use playground page URLs as proxyUrl: the proxy speaks our JSON API.
# VITE_JAVA_SANDBOX_PROVIDERS='[{"label":"dev.java","url":"https://dev.java/playground/"},{"label":"Java Almanac 28","url":"https://javaalmanac.io/jdk/28/"}]'
