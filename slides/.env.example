# Optional: override JAVA_HOME/PATH for the local Java sandbox only.
# Copy to .env.local, set the absolute JDK home (not its bin directory),
# and restart the Slidev server. Without this setting, JAVA_HOME/PATH applies.
# JAVA_SANDBOX_HOME=/absolute/path/to/jdk

# External execution, public URL including /run. No tokens/secrets in this URL.
# This value is embedded into the static client at build time.
# VITE_JAVA_SANDBOX_PROXY_URL=https://your-proxy.example/run
